   "voice_end": 12.379333333333333,
   "caps": [
    {
     "text": "To make more,",
     "t0": 6.71825,
     "t1": 7.674017316017316
    },
    {
     "text": "tiny mitochondria use",
     "t0": 7.674017316017316,
     "t1": 9.070908008658009
    },
    {
     "text": "extra oxygen,",
     "t0": 9.070908008658009,
     "t1": 10.100195887445887
    },
    {
     "text": "and release extra",
     "t0": 10.100195887445887,
     "t1": 11.20300432900433
    },
    {
     "text": "carbon dioxide.",
     "t0": 11.20300432900433,
     "t1": 12.379333333333333
    }
