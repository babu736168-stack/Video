  {
   "id": "intro",
   "text": "Why do you breathe faster when you run?",
   "voice_start": 0.15,
   "voice_end": 1.6886666666666665,
   "caps": [
    {
     "text": "Why do you",
     "t0": 0.15,
     "t1": 0.5120392156862745
    },
    {
     "text": "breathe faster when",
     "t0": 0.5120392156862745,
     "t1": 1.2813725490196077
    },
    {
     "text": "you run?",
     "t0": 1.2813725490196077,
     "t1": 1.6886666666666665
    }
   ],
   "start": 0.0,
   "end": 1.7486666666666664
  },
  {
   "id": "muscles",
   "text": "Every stride makes your leg muscles burn through ATP, their energy, much faster.",
   "voice_start": 1.8086666666666664,
   "voice_end": 6.59825,
   "caps": [
    {
     "text": "Every stride makes",
     "t0": 1.8086666666666664,
     "t1": 2.844252252252252
    },
    {
     "text": "your leg muscles",
     "t0": 2.844252252252252,
     "t1": 3.7503896396396397
    },
    {
     "text": "burn through ATP,",
     "t0": 3.7503896396396397,
     "t1": 4.850699324324324
    },
    {
     "text": "their energy,",
     "t0": 4.850699324324324,
     "t1": 5.756836711711712
    },
    {
     "text": "much faster.",
     "t0": 5.756836711711712,
     "t1": 6.59825
    }
